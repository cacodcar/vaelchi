{
  "version": "2.0.0",
  "options": {
    "cwd": "${workspaceFolder}",
    "env": {
      "PYTHONDONTWRITEBYTECODE": "1"
    }
  },
  "presentation": {
    "reveal": "always",
    "panel": "shared",
    "echo": true
  },
  "tasks": [
    {
      "label": "Vaelchi: Test Coverage",
      "type": "process",
      "command": "${workspaceFolder}/.quality-venv/bin/python",
      "args": [
        "tools/quality.py",
        "tests"
      ],
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Vaelchi: Cyclomatic Complexity",
      "type": "process",
      "command": "${workspaceFolder}/.quality-venv/bin/python",
      "args": [
        "tools/quality.py",
        "complexity"
      ],
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Vaelchi: Maintainability Index",
      "type": "process",
      "command": "${workspaceFolder}/.quality-venv/bin/python",
      "args": [
        "tools/quality.py",
        "maintainability"
      ],
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Vaelchi: Raw Metrics",
      "type": "process",
      "command": "${workspaceFolder}/.quality-venv/bin/python",
      "args": [
        "tools/quality.py",
        "raw"
      ],
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Vaelchi: Lint",
      "type": "process",
      "command": "${workspaceFolder}/.quality-venv/bin/python",
      "args": [
        "tools/quality.py",
        "lint"
      ],
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Vaelchi: Format Check",
      "type": "process",
      "command": "${workspaceFolder}/.quality-venv/bin/python",
      "args": [
        "tools/quality.py",
        "format"
      ],
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Vaelchi: Type Check",
      "type": "process",
      "command": "${workspaceFolder}/.quality-venv/bin/python",
      "args": [
        "tools/quality.py",
        "types"
      ],
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Vaelchi: Documentation Build",
      "type": "process",
      "command": "${workspaceFolder}/.quality-venv/bin/python",
      "args": [
        "tools/quality.py",
        "docs"
      ],
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Vaelchi: Dependency Check",
      "type": "process",
      "command": "${workspaceFolder}/.quality-venv/bin/python",
      "args": [
        "tools/quality.py",
        "dependencies"
      ],
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Vaelchi: All Quality Checks",
      "type": "process",
      "command": "${workspaceFolder}/.quality-venv/bin/python",
      "args": [
        "tools/quality.py",
        "all"
      ],
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Vaelchi: Locked Quality Baseline",
      "type": "process",
      "command": "${workspaceFolder}/.quality-venv/bin/python",
      "args": [
        "tools/quality.py",
        "all",
        "--baseline"
      ],
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Vaelchi: Python Version Matrix",
      "type": "process",
      "command": "${workspaceFolder}/.quality-venv/bin/python",
      "args": [
        "-m",
        "tox"
      ],
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Vaelchi: Complexity B or worse report",
      "type": "process",
      "command": "${workspaceFolder}/.quality-venv/bin/python",
      "args": [
        "-m",
        "radon",
        "cc",
        "src",
        "--min",
        "B",
        "-s",
        "-a"
      ],
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Vaelchi: Build Distributions",
      "type": "process",
      "command": "${workspaceFolder}/.quality-venv/bin/python",
      "args": [
        "-m",
        "build"
      ],
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Vaelchi: Run Example",
      "type": "process",
      "command": "${workspaceFolder}/.quality-venv/bin/python",
      "args": [
        "examples/representative_days.py"
      ],
      "group": "test",
      "problemMatcher": []
    }
  ]
}
